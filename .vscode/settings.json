{
  // Open every Markdown file in the formatted preview (clickable drop-downs).
  // To edit one: right-click its tab → "Reopen Editor With..." → "Text Editor".
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  // No grey AI ghost text in this repo: practice code is typed by hand.
  "editor.inlineSuggest.enabled": false
}
