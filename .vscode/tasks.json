{
  // Terminal → Run Task... → "Start learning hub", then open http://127.0.0.1:8765
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start learning hub",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "hub"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
