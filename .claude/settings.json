{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Read(*.env)",
      "Edit(*.env)",
      "Read(.env.*)",
      "Edit(.env.*)",
      "Read(~/.dbt/**)",
      "Edit(~/.dbt/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",

      "Bash(gh pr merge *)",

      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git -C * push * +*)",
      "Bash(git -C * push * main)",
      "Bash(git -C * push * main *)",
      "Bash(git -C * push * *:main)",

      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git -C * commit *--no-verify*)",
      "Bash(git -C * commit -n*)",
      "Bash(git -C * commit * -n)",
      "Bash(git -C * commit * -n *)",

      "Bash(git reset --hard *)",
      "Bash(git reset * --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(git -C * reset --hard *)",
      "Bash(git -C * reset * --hard *)",
      "Bash(git -C * clean *)",
      "Bash(git -C * checkout -- .)",
      "Bash(git -C * restore .)",
      "Bash(git -C * stash drop*)",
      "Bash(git -C * stash clear*)",
      "Bash(git -C * branch -D *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py", "pre-commit-scan"],
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py", "post-edit-ruff"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/Scripts/python.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py", "stop-pytest"],
            "timeout": 90
          }
        ]
      }
    ]
  }
}
